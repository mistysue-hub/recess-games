='30' fill='#d8cfbf'/><text x='255' y='250' font-family='Special Elite, Courier New, monospace' font-size='9' fill='#2a2420' text-anchor='middle' >Portland</text><text x='60' y='30' font-family='Special Elite, Courier New, monospace' font-size='9' fill='#5a4a3a' text-anchor='middle' >WASHINGTON</text><text x='60' y='240' font-family='Special Elite, Courier New, monospace' font-size='9' fill='#5a4a3a' text-anchor='middle' >OREGON</text></svg>
