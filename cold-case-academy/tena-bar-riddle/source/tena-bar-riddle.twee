:: StoryInit
<<set setup.moduleRef to "M03">>
<<set setup.leadsTotal to 7>>
<<set setup.dedTotal to 7>>
<<set setup.typeLabel to { survived: "Points to: survived", didnt: "Points to: didn't survive", neither: "Doesn't decide", assumption: "Guess", deduction: "Deduction" }>>
<<set setup.cards = {
  "bundles":  { title: "Three bundles of twenties", text: "About $5,800 in rotting $20 bills, a few inches under the sand, still held together with rubber bands.", type: "neither" },
  "place":    { title: "Where Tena Bar is", text: "A sandy beach on the Columbia River, about 9 miles downstream from Vancouver, Washington, and about 20 miles southwest of Ariel, where the first search happened.", type: "neither" },
  "trench":   { title: "Your own trench", text: "Dig a little deeper near the hole and you hit a layer of gray clay. Above it are layers of ordinary river sand. The money was up in the sand.", type: "neither" },
  "match":    { title: "The serial numbers match", text: "The numbers match the FBI's 1971 microfilm list. This is the ransom money. It's the first ransom money ever found.", type: "neither" },
  "unspent":  { title: "None of it was ever spent", text: "Banks have had the list of 10,000 serial numbers for nine years. Not one ransom bill has turned up anywhere else.", type: "didnt" },
  "banded":   { title: "Rubber bands still on", text: "If bundles drifted in a river for years, the rubber bands would rot and the bills would scatter. These stayed together, so they likely didn't drift for long.", type: "neither" },
  "layers":   { title: "The sand layers", text: "Geologist Leonard Palmer found the money sitting above the clay a dredging boat dumped on the beach in 1974, with natural river sand in between. So the money arrived after 1974.", type: "neither" },
  "dredge":   { title: "The 1974 dredging", text: "In 1974, a boat dredged the river bottom and spread the mud and sand on Tena Bar. Some people thought the money came with it.", type: "neither" },
  "buried":   { title: "Maybe someone buried it", text: "The sand layers show when the money arrived, not how. A person with a shovel could have put it there. Nothing proves it, and nothing rules it out.", type: "neither" },
  "rivers":   { title: "Which way the rivers flow", text: "The Lewis River, which runs past Ariel, joins the Columbia downstream of Tena Bar, so nothing could float from it up to the beach. The Washougal River joins upstream.", type: "neither" },
  "night":    { title: "A brutal night to jump", text: "Dark, freezing, sleet, over thick forest, with no lights below to aim for.", type: "didnt" },
  "weather":  { title: "Weather records", text: "That night: sleet and freezing temperatures at 10,000 feet, with low clouds over the forest.", type: "didnt" },
  "clothes":  { title: "Dressed for an office", text: "He jumped in a business suit, a raincoat and ordinary street shoes. No jumpsuit, no helmet, no boots.", type: "didnt" },
  "chute":    { title: "An older, harder chute", text: "Of the two main parachutes, he took the older military-style one, which is harder to steer. The reserve he took was a classroom dummy, sewn shut.", type: "didnt" },
  "planner":  { title: "A careful plan", text: "He asked for four parachutes so nobody could hand him a broken one, and made the plane fly low and slow with the stairs ready.", type: "survived" },
  "nothing":  { title: "Nothing found in the woods", text: "Weeks of searching by soldiers, police and volunteers found no body, no parachute and no money in the woods.", type: "survived" },
  "placard":  { title: "The 1978 placard", text: "In 1978, a deer hunter found a 727 sign with instructions for lowering the back stairs, north of Lake Merwin, right under the flight path.", type: "neither" },
  "rich":     { title: "“He's living rich in Mexico”", text: "A newspaper story says he's surely on a beach somewhere, spending the money.", type: "assumption" },
  "dead":     { title: "“The beach is his grave”", text: "Another story says the money proves he crashed right there.", type: "assumption" },

  "d_late":   { title: "The money got there late", text: "Rubber bands intact and sitting above the 1974 clay: the money reached the beach years after 1971, and didn't drift there slowly.", type: "deduction", leans: "neither" },
  "d_notLewis":{ title: "Not down the Lewis", text: "If the money came down a river, it wasn't the Lewis, which runs past the first search area. It joins the Columbia below the beach.", type: "deduction", leans: "neither" },
  "d_brutal": { title: "The odds were against him", text: "A freezing, stormy night and office clothes: a hard landing even for an expert.", type: "deduction", leans: "didnt" },
  "d_gear":   { title: "Not equipped like a skydiver", text: "Street shoes, no helmet, a harder-to-steer chute and a dummy reserve: he didn't jump like an experienced skydiver.", type: "deduction", leans: "didnt" },
  "d_spent":  { title: "He never spent it", text: "The money is real and none of it ever surfaced. Either he couldn't spend it, or he was very careful not to.", type: "deduction", leans: "didnt" },
  "d_vanish": { title: "A planner who left no trace", text: "Careful planning, and a huge search that found nothing at all. Maybe he got away, or maybe he landed somewhere nobody looked.", type: "deduction", leans: "survived" },
  "d_dredge": { title: "Not the dredge", text: "The dredge clay is underneath, and the money was above it. The money didn't arrive with the 1974 dredging.", type: "deduction", leans: "neither" }
}>>
