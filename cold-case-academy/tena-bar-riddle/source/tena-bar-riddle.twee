<<set setup.interviews = {
  "palmer": [
    { q: "Did the money come with the dredge sand?", a: "“No. The dredge clay is down here. The money was above it, with layers of natural river sand in between. It arrived after 1974.”", clue: "layers" },
    { q: "What was the dredging?", a: "“In 1974 a dredge pulled mud and sand off the river bottom and dumped it on this beach. That's the gray clay layer.”", clue: "dredge" },
    { q: "Can the layers tell you how the money got here?", a: "“They tell me when, not how. Washed up by the river, or put here by a person with a shovel? The sand can't say.”", clue: "buried" },
    { q: "What does the beach look like underneath?", a: "“Like a layer cake. Ordinary sand on top, then the clay from the dredge. Dig anywhere near the hole and you'll see it.”", clue: "trench" }
  ]
}>>
<<set setup.events = [
  { at: 6, id: "e1", kind: "headline", text: "BOY FINDS HIJACK CASH ON COLUMBIA RIVER BEACH" },
  { at: 4, id: "e2", kind: "chief", text: "Your supervisor calls: “Reporters want to know: is Cooper dead or alive? And how did that money get on the beach?”" },
  { at: 2, id: "e3", kind: "headline", text: "TREASURE HUNTERS FLOCK TO TENA BAR WITH SHOVELS" }
]>>
<<set setup.theories = [
  { id: "tDredge", text: "It came with the 1974 dredge sand", answer: "out", needs: ["layers","trench","d_dredge"], why: "The money was above the dredge clay, so it arrived after 1974." },
  { id: "tDrift",  text: "It drifted in the river for years", answer: "out", needs: ["banded","d_late"], why: "The rubber bands were still on. Years in the water would have rotted them." },
  { id: "tLewis",  text: "It washed down the Lewis River from near Ariel", answer: "out", needs: ["rivers","d_notLewis"], why: "The Lewis joins the Columbia below Tena Bar. Water doesn't flow uphill." },
  { id: "tBuried", text: "Someone buried it there", answer: "possible", needs: [], why: "Nothing proves it, and nothing rules it out." }
]>>
<<set setup.suspects = [
  { id: "mccoy", name: "Richard McCoy Jr.", facts: ["In April 1972, five months after Flight 305, he hijacked a different plane, collected $500,000 and parachutes, and jumped over Utah. He was caught within days and sent to prison.", "An Army veteran and helicopter pilot, in his late twenties in 1971.", "The FBI says he didn't match the flight attendants' description, and that he was at home in Utah having Thanksgiving dinner with his family the day after the Cooper hijacking.", "His family still argues he was Cooper. The FBI hasn't changed its view."], answer: "out", why: "Too young for the mid-forties description, and the FBI says he was home for Thanksgiving dinner the next day. Copying a crime isn't proof of committing the first one." },
  { id: "christiansen", name: "Kenneth Christiansen", facts: ["Worked for Northwest Orient, the same airline as Flight 305, and had trained as an Army paratrooper.", "He was in his mid-forties in 1971, which fits the description.", "He was about 5 feet 8: shorter than the flight attendants described, closer to what passenger Bill Mitchell remembered.", "Shown his photos years later, Florence Schaffner said he looked more like the hijacker than the other suspects, but she couldn't say for sure it was him. He died in 1994 and was never charged."], answer: "possible", why: "His age fits and Schaffner said his photos were the closest match, but his height doesn't fit two witnesses. Not enough to rule him in or out." },
  { id: "rackstraw", name: "Robert Rackstraw", facts: ["An Army paratrooper and pilot who served in Vietnam.", "He was about 28 in 1971.", "The FBI looked at him and cleared him in the 1970s. A flight attendant couldn't identify him from his photo.", "Years later he joked that he was Cooper, then said he'd made it up. He died in 2019."], answer: "out", why: "Far younger than the mid-forties man two witnesses described, cleared by the FBI, and not recognized by a witness. A joke isn't a confession." },
  { id: "weber", name: "Duane Weber", facts: ["Shortly before he died in 1995, he told his wife, “I'm Dan Cooper.”", "The FBI compared his DNA with the partial DNA profile from Cooper's tie. It didn't match, and the FBI ruled him out.", "But the FBI also says the tie DNA isn't a strong sample, and the tie might have been secondhand."], answer: "either", why: "The FBI ruled him out with DNA. But the tie DNA might not even be Cooper's, so careful detectives can call it either way." },
  { id: "peterson", name: "Sheridan Peterson", facts: ["Had worked for Boeing on 727 manuals, so he knew about the back stairs. An experienced skydiver.", "His eyes were blue. Both flight attendants said the hijacker's eyes were brown.", "He said he was in Nepal at the time of the hijacking. Nobody has proven or disproven that."], answer: "either", why: "His know-how fits, but his eye color doesn't match two witnesses, and his alibi is unproven. Reasonable detectives disagree." }
]>>
