</svg>
</figure>
<div class="choices">
<span @class="$riv.includes('w') ? 'opt chosen' : 'opt'"><<link "Follow the Washougal River">><<run $riv.pushUnique("w")>><<goto "RiverMap">><</link>></span>
<span @class="$riv.includes('l') ? 'opt chosen' : 'opt'"><<link "Follow the Lewis River">><<run $riv.pushUnique("l")>><<goto "RiverMap">><</link>></span>
</div>
<<if $riv.includes("w")>><p class="quote">The Washougal flows into the Columbia east of Vancouver, <b>upstream</b> of Tena Bar. Something floating in it could reach the beach.</p><</if>>
<<if $riv.includes("l")>><p class="quote">The Lewis runs past Ariel and Lake Merwin, where the first search happened. It flows into the Columbia <b>downstream</b> of Tena Bar. Something floating in it would never reach the beach.</p><</if>>
<<if $riv.includes("w") and $riv.includes("l")>><<clue "rivers">><</if>>
