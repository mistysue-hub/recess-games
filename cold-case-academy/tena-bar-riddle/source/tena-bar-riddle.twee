<ellipse cx="276" cy="97" rx="24" ry="7" fill="#7fa7cc"/>
<circle cx="205" cy="262" r="4" fill="#2a2420"/><text x="212" y="278" font-size="12" fill="#2a2420">Vancouver, WA</text>
<circle cx="150" cy="210" r="6" fill="#a3231d"/><text x="160" y="214" font-size="13" font-weight="700" fill="#a3231d">Tena Bar</text>
<circle cx="246" cy="101" r="4" fill="#2a2420"/><text x="230" y="90" font-size="12" fill="#2a2420">Ariel</text>
