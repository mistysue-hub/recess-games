  { a: "dredge", b: "trench", id: "d_dredge" },
  { a: "dredge", b: "layers", id: "d_dredge" }
]>>
<<set setup.interviews = {
  "palmer": [
    { q: "Did the money come with the dredge sand?", a: "“No. The dredge clay is down here. The money was above it, with layers of natural river sand in between. It arrived after 1974.”", clue: "layers" },
    { q: "What was the dredging?", a: "“In 1974 a dredge pulled mud and sand off the river bottom and dumped it on this beach. That's the gray clay layer.”", clue: "dredge" },
    { q: "Can the layers tell you how the money got here?", a: "“They tell me when, not how. Washed up by the river, or put here by a person with a shovel? The sand can't say.”", clue: "buried" },
    { q: "What does the beach look like underneath?", a: "“Like a layer cake. Ordinary sand on top, then the clay from the dredge. Dig anywhere near the hole and you'll see it.”", clue: "trench" }
  ]
}>>
<<set setup.events = [
  { at: 6, id: "e1", kind: "headline", text: "BOY FINDS HIJACK CASH ON COLUMBIA RIVER BEACH" },
  { at: 4, id: "e2", kind: "chief", text: "Your supervisor calls: “Reporters want to know: is Cooper dead or alive? And how did that money get on the beach?”" },
  { at: 2, id: "e3", kind: "headline", text: "TREASURE HUNTERS FLOCK TO TENA BAR WITH SHOVELS" }
]>>
<<set setup.theories = [
  { id: "tDredge", text: "It came with the 1974 dredge sand", answer: "out", needs: ["layers","trench","d_dredge"], why: "The money was above the dredge clay, so it arrived after 1974." },
  { id: "tDrift",  text: "It drifted in the river for years", answer: "out", needs: ["banded","d_late"], why: "The rubber bands were still on. Years in the water would have rotted them." },
  { id: "tLewis",  text: "It washed down the Lewis River from near Ariel", answer: "out", needs: ["rivers","d_notLewis"], why: "The Lewis joins the Columbia below Tena Bar. Water doesn't flow uphill." },
  { id: "tBuried", text: "Someone buried it there", answer: "possible", needs: [], why: "Nothing proves it, and nothing rules it out." }
]>>
<<set setup.suspects = [
  { id: "mccoy", name: "Richard McCoy Jr.", facts: ["In April 1972, five months after Flight 305, he hijacked a different plane, collected $500,000 and parachutes, and jumped over Utah. He was arrested two days later and sent to prison.", "An Army veteran and helicopter pilot, about 28 in 1971.", "The FBI says he didn't match the flight attendants' description, and that he was at home in Utah having Thanksgiving dinner with his family the day after the Cooper hijacking.", "His family still argues he was Cooper. The FBI has never formally cleared him."], keys: [["He pulled a similar hijacking five months later", false], ["His age, and where the FBI says he was on Thanksgiving", true], ["His family believes it was him", false]], note: "Copying a crime isn't proof of committing the first one, and a family's belief isn't evidence. His age and the Thanksgiving alibi are the evidence that can actually be checked." },
  { id: "christiansen", name: "Kenneth Christiansen", facts: ["Worked for Northwest Orient, the same airline as Flight 305, and had trained as an Army paratrooper.", "He was 45 in 1971, which fits the mid-forties description.", "He was about 5 feet 8 and slim: shorter and lighter than the flight attendants described. That's why the FBI dismissed him.", "Shown his photos years later, Florence Schaffner said he looked more like the hijacker than the other suspects, but she couldn't say for sure it was him. He died in 1994 and was never charged."], keys: [["He worked for the same airline", false], ["His height and build, compared with two witnesses", true], ["Schaffner's reaction to his photos", true]], note: "Working for the airline only shows he could have known about planes. His height and Schaffner's reaction are real evidence, and they point in different directions." },
  { id: "rackstraw", name: "Robert Rackstraw", facts: ["An Army paratrooper and pilot who served in Vietnam.", "He was about 28 in 1971.", "The FBI looked at him and cleared him in the 1970s. A flight attendant couldn't identify him from his photo.", "Years later he hinted that he was Cooper, then said he'd made it up. He died in 2019."], keys: [["He hinted that he was Cooper", false], ["His age, compared with the mid-forties description", true], ["He was a paratrooper", false]], note: "A hint or a joke isn't a confession, and lots of people were paratroopers. His age is checkable, and it doesn't fit two witnesses." },
  { id: "weber", name: "Duane Weber", facts: ["Shortly before he died in 1995, he told his wife, “I'm Dan Cooper.”", "The FBI compared his DNA with the partial DNA profile from Cooper's tie. It didn't match, and the FBI ruled him out.", "But the FBI also says the tie DNA isn't a strong sample, and the tie might have been secondhand."], keys: [["What he said before he died", false], ["The tie DNA didn't match", true]], note: "Words aren't proof. The DNA test is the real evidence, even with its weaknesses." },
  { id: "peterson", name: "Sheridan Peterson", facts: ["Worked for Boeing as a technical editor, and was an expert skydiver and smokejumper.", "His eyes were blue. The flight attendants described the hijacker's eyes as brown.", "He said he was in Nepal at the time of the hijacking. Nobody has proven or disproven that."], keys: [["His skydiving skill", false], ["His eye color, compared with the witnesses", true], ["He said he was in Nepal", false]], note: "Skill shows he could have done it, not that he did, and an unchecked alibi doesn't settle anything. Eye color is something witnesses saw." }
]>>
