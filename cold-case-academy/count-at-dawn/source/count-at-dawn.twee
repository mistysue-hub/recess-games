<<set setup.moduleRef to "M04">>
<<set setup.leadsTotal to 6>>
<<set setup.dedTotal to 6>>
<<set setup.typeLabel to { evidence: "Fact", single: "One witness", assumption: "Guess", deduction: "Deduction" }>>
<<set setup.cards = {
  "hole":      { title: "The hole behind the sink", text: "Under the sink in each empty cell, the small air vent has been dug out wide enough for a man to squeeze through. The concrete around it is chipped and crumbly.", type: "evidence" },
  "cardboard": { title: "A fake vent cover", text: "Leaning in Morris's cell: a piece of cardboard painted to look like the metal vent grille. From the doorway it looked real.", type: "evidence" },
  "tools":     { title: "Spoons and saw blades", text: "Metal spoons from the dining hall, worn down at the edges, and pieces of old saw blades.", type: "evidence" },
  "drill":     { title: "A homemade drill", text: "A drill built from the motor of a broken vacuum cleaner.", type: "evidence" },
  "head":      { title: "The fake heads", text: "Three dummy heads made from soap, toothpaste, concrete dust and toilet paper, painted, with real human hair.", type: "evidence" },
  "hair":      { title: "The barbershop floor", text: "The barbershop floor is swept every day. The hair on the fake heads is real human hair, like the clippings that land here.", type: "evidence" },
  "accordion": { title: "Music hour", text: "Every day during music hour, Frank Morris played his accordion. It was loud.", type: "evidence" },
  "corridor":  { title: "The utility corridor", text: "Behind the cells runs a narrow, dark corridor full of pipes and wires. From inside it, you could climb the pipes all the way to the top of the cellblock.", type: "evidence" },
  "workshop":  { title: "The rooftop workshop", text: "At the unused top of the cellblock: blankets hung up to hide a work area, scraps of raincoat, and tools.", type: "evidence" },
  "extras":    { title: "What was left in the workshop", text: "An unfinished float, a plywood paddle, three life vests and a partly finished extra raft, all left behind.", type: "evidence" },
  "roofvent":  { title: "The roof vent, broken open", text: "A ventilation shaft leads from the workshop up to the roof. Its cover has been forced open. A guard remembers hearing a loud crash in the night.", type: "evidence" },
  "pipe":      { title: "The kitchen vent pipe", text: "A pipe runs about 50 feet down the outside wall from the roof to the ground. Investigators concluded the men slid down it to the ground.", type: "evidence" },
  "fences":    { title: "Two fences", text: "Between the cellhouse and the water are two 12-foot fences topped with barbed wire. The men got over both.", type: "evidence" },
  "shore":     { title: "The northeast shore", text: "A rocky spot near the power plant, out of sight of the searchlights and gun towers.", type: "evidence" },
  "raincoats": { title: "Missing raincoats", text: "More than 50 prison raincoats can't be accounted for. Their rubbery cloth is perfect for something that floats.", type: "evidence" },
  "glue":      { title: "Liquid plastic and steam pipes", text: "Liquid plastic from the prison shops is missing. Seams in the raincoat scraps were glued with it and set with heat from the hot steam pipes.", type: "evidence" },
  "magazine":  { title: "A how-to magazine", text: "A popular science and how-to magazine. Investigators matched the men's vest and raft ideas to its articles.", type: "evidence" },
  "lightsout": { title: "Lights out: 9:30 p.m.", text: "On June 11, lights went out at 9:30 p.m. The three men were in their cells then.", type: "evidence" },
  "count":     { title: "Every count, all present", text: "All night, guards checked the cells and marked every man present. Each time, they saw what looked like a sleeping man.", type: "evidence" },
  "found":     { title: "7:00 a.m.", text: "At about 7:00 a.m. on June 12, a guard reached in to wake Clarence Anglin. The head fell onto the floor.", type: "evidence" },
  "plan":      { title: "West: the plan", text: "Allen West says they planned to paddle to Angel Island, cross to the mainland, steal clothes and a car, and split up.", type: "single" },
  "jam":       { title: "West: why he stayed", text: "West says cement he'd used to hold his loose vent cover in place hardened. His vent jammed, and by the time he broke through, the others were gone.", type: "single" },
  "tunnel":    { title: "“They tunneled under the floor”", text: "A reporter is sure they dug a tunnel under the cellhouse.", type: "assumption" },
  "inside":    { title: "“Someone inside helped them”", text: "Another reporter says they must have had help from a guard.", type: "assumption" },

  "d_months": { title: "Months of quiet work", text: "Holes dug with spoons, hidden behind painted cardboard: this took months, not one night.", type: "deduction" },
  "d_noise":  { title: "Hiding the noise", text: "A vacuum-motor drill is loud. Morris's accordion during music hour covered the sound.", type: "deduction" },
  "d_heads":  { title: "The heads bought them hours", text: "Every count all night found a “sleeping man.” The fake heads gave them a head start until morning.", type: "deduction" },
  "d_raft":   { title: "A raft from a magazine", text: "Missing raincoats and a how-to magazine: they built their boat from an idea in print.", type: "deduction" },
  "d_four":   { title: "The plan was for four", text: "Extra vests and an extra raft left in the workshop, and West's jammed vent: four men planned to go, but only three made it out.", type: "deduction" },
  "d_blind":  { title: "They picked a blind spot", text: "Over the fences to the one stretch of shore the searchlights and towers couldn't see.", type: "deduction" }
}>>
<<set setup.recipes = [
  { a: "hole", b: "cardboard", id: "d_months" },
  { a: "tools", b: "cardboard", id: "d_months" },
  { a: "drill", b: "accordion", id: "d_noise" },
  { a: "head", b: "count", id: "d_heads" },
  { a: "raincoats", b: "magazine", id: "d_raft" },
  { a: "extras", b: "jam", id: "d_four" },
  { a: "fences", b: "shore", id: "d_blind" }
]>>
<<set setup.route = [
  { id: "r1", need: "hole",     text: "Squeeze out through the hole behind the sink", why: "They had to get out of their cells first." },
  { id: "r2", need: "corridor", text: "Crawl into the utility corridor", why: "The corridor is only reachable through the vent holes." },
  { id: "r3", need: "workshop", text: "Climb the pipes to the rooftop workshop", why: "The workshop is at the top of the corridor." },
  { id: "r4", need: "roofvent", text: "Break out through the roof vent", why: "The roof vent leads up from the workshop." },
  { id: "r5", need: "pipe",     text: "Slide down the kitchen vent pipe", why: "The pipe runs down from the roof." },
  { id: "r6", need: "fences",   text: "Climb the two fences", why: "The fences are between the building and the water." },
  { id: "r7", need: "shore",    text: "Blow up the raft and push off from the northeast shore", why: "The shore is past the fences." }
]>>
