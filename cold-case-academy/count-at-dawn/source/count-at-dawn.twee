]>>
<<set setup.interviews = {
  "west": [
    { q: "Where were they going?", a: "“Angel Island first. Then across to the mainland, grab some clothes and a car, and split up.”", clue: "plan" },
    { q: "Why are you still here?", a: "“I'd cemented my vent cover so it wouldn't fall off. The cement set hard. By the time I chipped through, they were gone.”", clue: "jam" },
    { q: "Where did the raincoats go?", a: "“Up to the workshop. We stitched and glued them together. It took forever.”", clue: "raincoats" },
    { q: "Who made the heads?", a: "“Each of us made his own. Soap, toilet paper, concrete dust. The hair came from the barbershop floor.”", clue: "hair" }
  ]
