:: CaseTheme [stylesheet]
:root { --accent: #2f6b3a; }
#passages { border-top-color: var(--accent); }
h1 { color: var(--accent); }
.map a { border-left: 6px solid var(--accent); }
.actions a, .actions .macro-link { background: var(--accent); }
.actions.secondary a, .actions.secondary .macro-link { background: transparent; color: var(--accent); border-color: var(--accent); }
.card { border-top-color: var(--accent); }
svg.art { display: block; width: 100%; height: auto; border-radius: 6px; margin: 0 0 16px; box-shadow: 0 2px 8px rgba(0,0,0,.25); }
.sortrow.picked { border: 2px solid var(--accent); background: #eef6ee; }
.sortrow .card-text { display: block; margin: 0 0 8px; }
.reveal .card.fact { border-top-color: var(--evidence); } .card.fact .tag { color: var(--evidence); }
.reveal .card.claim { border-top-color: #c98a00; } .card.claim .tag { color: #8a5a00; }
.reveal .card.opinion { border-top-color: #2f5d8a; } .card.opinion .tag { color: #2f5d8a; }
.reveal .card.guess { border-top-color: var(--stamp); } .card.guess .tag { color: var(--stamp); }
.report { background: #fffdf6; border: 1px solid var(--line); border-left: 6px solid var(--accent); padding: 16px 18px; border-radius: 4px; box-shadow: 0 2px 8px rgba(60,40,20,.15); }
.report p { margin: 0 0 8px; }
.report ol, .report ul { margin: 0 0 10px; padding-left: 1.3em; }
.report li { margin-bottom: 4px; }
.report-head { font-family: var(--display); text-transform: uppercase; letter-spacing: .12em; color: var(--muted); font-size: .85rem; }
.report-case { font-family: var(--display); font-size: 1.3rem; }
.report-part { font-family: var(--display); text-transform: uppercase; letter-spacing: .08em; font-size: .9rem; color: var(--accent); margin-top: 14px !important; border-bottom: 1px solid var(--line); }
.report-sign { font-family: var(--display); margin-top: 16px !important; }
