<<set setup.moduleRef to "M05">>
<<set setup.leadsTotal to 7>>
<<set setup.dedTotal to 5>>
<<set setup.kindLabel to { fact: "Tested fact", claim: "Untested claim", opinion: "Expert opinion", assumption: "Guess", deduction: "Deduction" }>>
<<set setup.leanLabel to { made: "Points to: made it", drowned: "Points to: drowned", neither: "Doesn't decide" }>>
<<set setup.cards = {
  "paddle":    { title: "A paddle near Angel Island", text: "On June 14, three days after the escape, a Coast Guard boat picked up a homemade paddle floating about 200 yards off the southern shore of Angel Island.", type: "fact", lean: "neither" },
  "packet":    { title: "The plastic-wrapped packet", text: "Found in the bay: a packet sealed in plastic, holding names, addresses and photos of the Anglins' friends and relatives.", type: "fact", lean: "neither" },
  "vests":     { title: "Two life vests", text: "One homemade vest washed up on Cronkhite Beach, outside the Golden Gate Bridge. Another was found floating just off Alcatraz, its strings still knotted at the back.", type: "fact", lean: "drowned" },
  "nobodies":  { title: "No bodies, ever", text: "In more than 60 years, no body of any of the three men has ever been found.", type: "fact", lean: "made" },
  "cold":      { title: "Cold, fast water", text: "The bay is usually in the 50s °F, with strong tidal currents rushing in and out under the Golden Gate Bridge.", type: "fact", lean: "drowned" },
  "scott":     { title: "John Paul Scott, December 1962", text: "Six months later, another prisoner swam from Alcatraz using blown-up rubber gloves. He reached the shore near the Golden Gate Bridge, but was found exhausted and dangerously cold, treated in a hospital, and taken back.", type: "fact", lean: "neither" },
  "nothefts":  { title: "No matching thefts", text: "The FBI found no reports of stolen clothes or cars near the bay that fit the escape plan.", type: "fact", lean: "drowned" },
  "fbi79":     { title: "The FBI's verdict, 1979", text: "After 17 years, the FBI closed its case on December 31, 1979, concluding the men most likely drowned.", type: "opinion", lean: "drowned" },
  "west":      { title: "Allen West's statement", text: "West said the plan was Angel Island, then the mainland, then stolen clothes and a car. He never saw them leave the island.", type: "claim", lean: "neither" },
  "cards":     { title: "The Christmas cards", text: "Family members say the brothers' mother received Christmas cards signed by John and Clarence for a few years. Nobody could prove when they were written.", type: "claim", lean: "made" },
  "roses":     { title: "The roses", text: "A nephew says his grandmother received roses for several years after the escape. The family believed her sons sent them.", type: "claim", lean: "made" },
  "photo":     { title: "The photo from Brazil", text: "A family friend said he took this photo in Brazil in 1975. Two men who look like the Anglin brothers, wearing sunglasses. Old and blurry.", type: "claim", lean: "made" },
  "letter":    { title: "The 2013 letter", text: "A letter to San Francisco police, signed as John Anglin: “We all made it that night but barely.” It said Morris and Clarence had since died.", type: "claim", lean: "made" },
  "lettertest":{ title: "The lab tests on the letter", text: "The FBI tested the letter for fingerprints, DNA and handwriting. The results were inconclusive: not proven real, not proven fake.", type: "fact", lean: "neither" },
  "roderick":  { title: "A marshal on the photo", text: "Art Roderick, the retired marshal who led the case for years, called the Brazil photo the best actionable lead they'd had.", type: "opinion", lean: "made" },
  "hoax":      { title: "The Marshals on the letter", text: "The Marshals Service said publicly that the letter looked like a hoax.", type: "opinion", lean: "drowned" },
  "rule99":    { title: "How long the hunt lasts", text: "One marshal said they hunt a fugitive until he's caught, proven dead, or about 99. Other reports say the warrants last until each man would turn 100. Frank Morris would have turned 100 on September 1, 2026.", type: "fact", lean: "neither" },
  "delft":     { title: "The tide model, 2014", text: "Scientists at Delft University modeled the bay's tides. A raft launched around 11:30 p.m. could have reached land near Horseshoe Bay, just inside the Golden Gate Bridge.", type: "fact", lean: "neither" },
  "timing":    { title: "“Really sensitive to timing”", text: "Scientist Rolf Hut says leaving at the wrong time could have sent the raft somewhere else entirely.", type: "opinion", lean: "neither" },
  "debris":    { title: "Where floating things drift", text: "In the tide model, later currents could carry floating objects toward Angel Island, even if the men landed somewhere else.", type: "fact", lean: "neither" },
  "notproof":  { title: "“The model can't tell you that”", text: "Rolf Hut says the model shows when the escape was possible, not what actually happened.", type: "opinion", lean: "neither" },
  "mythbusters":{ title: "The MythBusters test, 2003", text: "The TV show built a raft from raincoats with the same kinds of materials and paddled it to land near the north end of the Golden Gate Bridge.", type: "fact", lean: "neither" },
  "rober":     { title: "Mark Rober's crossing, 2025", text: "Engineer and YouTuber Mark Rober and a team built a raincoat raft and crossed the bay during the right tide.", type: "fact", lean: "neither" },
  "aged":      { title: "Age-progressed pictures, 2022", text: "The Marshals released computer-made pictures of how the three men might look as very old men, in case anyone recognized them.", type: "fact", lean: "neither" },
  "brazilbeach":{ title: "“They're on a beach in Brazil”", text: "A reporter is sure all three are living rich in South America.", type: "assumption", lean: "neither" },
  "guard":     { title: "“A guard had a boat waiting”", text: "Another reporter says someone must have picked them up by boat.", type: "assumption", lean: "neither" },

  "d_possible":{ title: "Possible isn't proven", text: "Three different teams showed a raincoat raft could cross. None of that shows the escapers did.", type: "deduction", lean: "neither" },
  "d_untest":  { title: "We can't test these", text: "A blurry photo and a letter nobody can trace: there's no way to check who is in one or who wrote the other.", type: "deduction", lean: "neither" },
  "d_plan":    { title: "The paddle fits the plan", text: "West said Angel Island, and a paddle turned up near Angel Island. But floating things drift, so it doesn't prove where the men went.", type: "deduction", lean: "neither" },
  "d_barely":  { title: "It can be done, barely", text: "Cold, fast water, and one man who did reach shore but nearly died: crossing was possible, and very dangerous.", type: "deduction", lean: "neither" },
  "d_notrace": { title: "No trace either way", text: "No bodies, and no thefts that fit the plan. The men left almost no trace, alive or dead.", type: "deduction", lean: "neither" }
}>>
<<set setup.recipes = [
  { a: "delft", b: "mythbusters", id: "d_possible" },
  { a: "delft", b: "rober", id: "d_possible" },
  { a: "mythbusters", b: "notproof", id: "d_possible" },
  { a: "photo", b: "letter", id: "d_untest" },
  { a: "photo", b: "lettertest", id: "d_untest" },
  { a: "paddle", b: "west", id: "d_plan" },
  { a: "paddle", b: "debris", id: "d_plan" },
  { a: "scott", b: "cold", id: "d_barely" },
  { a: "nobodies", b: "nothefts", id: "d_notrace" }
]>>
<<set setup.interviews = {
  "widner": [
    { q: "What did your grandmother get after the escape?", a: "“Christmas cards, for a few years, signed by John and Clarence. The family believed it was their handwriting. But nobody could ever prove when they were written.”", clue: "cards" },
    { q: "What's in the photo from Brazil?", a: "“A family friend said he took it in Brazil in 1975. Two men who look just like my uncles. It's old and they're wearing sunglasses, but we believe it's them.”", clue: "photo" },
    { q: "Did anything else ever arrive?", a: "“Roses. My grandmother got roses for several years after the escape. We always believed her sons sent them.”", clue: "roses" },
    { q: "What did you think of the 2013 letter?", a: "“It says all three made it that night. We'd love to know who really wrote it.”", clue: "letter" }
  ],
  "roderick": [
    { q: "What do you make of the Brazil photo?", a: "“When the family showed it to us, I called it the best actionable lead we'd had in years.”", clue: "roderick" },
    { q: "Was the 2013 letter real?", a: "“The lab couldn't prove it either way. The Marshals Service said publicly that it looked like a hoax.”", clue: "hoax" }
  ],
  "hut": [
    { q: "Could a raincoat raft reach land?", a: "“In our model, yes, if they launched around 11:30 p.m. They'd have landed near Horseshoe Bay, just inside the Golden Gate Bridge. It's very plausible they made landfall.”", clue: "delft" },
    { q: "What if they left at a different time?", a: "“It's really sensitive to timing. Leave at the wrong time and the current takes you somewhere else entirely.”", clue: "timing" },
    { q: "What about the paddle near Angel Island?", a: "“In our model, later currents could carry floating things toward Angel Island, even if the men landed somewhere else.”", clue: "debris" },
    { q: "So did they make it?", a: "“The model can't tell you that. It shows when the escape was possible, not what actually happened.”", clue: "notproof" }
  ]
}>>
<<set setup.events = [
  { at: 6, id: "e1", kind: "chief", text: "Your boss leans in: “That file is older than both of us. Decide what we tell people, and whether we keep it open.”" },
  { at: 4, id: "e2", kind: "headline", text: "ALCATRAZ MYSTERY: DID THE ESCAPERS MAKE IT?" },
  { at: 2, id: "e3", kind: "chief", text: "Your boss again: “Reporters keep calling. Wrap it up soon.”" }
]>>
<<set setup.sortOrder to ["cards","photo","letter","lettertest","fbi79","mythbusters","roderick","vests","west","delft","scott","hoax","nobodies","roses","timing"]>>
<<set setup.resultFields = function () { var v = State.variables; return { verdict: v.verdict, confidence: v.conf, fileDecision: v.decision, sortedRight: v.sortRight, sortedTotal: v.sortTotal }; }>>
