:: StoryInit
<<set setup.cards = {
  "hooks":      { title: "Four empty hooks", text: "The painting was lifted straight off the wall. No forced locks, no broken windows.", type: "evidence" },
  "genius":     { title: "“A genius did it”", text: "People keep saying only a master thief could pull this off.", type: "assumption" },
  "frame":      { title: "Frame left in the stairwell", text: "The thief took the painting out of its frame close by, in a quiet stairwell.", type: "evidence" },
  "print":      { title: "Fingerprint on the glass", text: "A clear thumbprint on the glass box.", type: "evidence" },
  "panel":      { title: "A wooden panel, not a canvas", text: "The painting is on a thin wooden board. It can't be rolled up, but it's small, about the size of a school notebook opened flat twice.", type: "evidence" },
  "smock":      { title: "A white smock looks like staff", text: "On Monday, anyone in a worker's white smock would look like he belonged.", type: "evidence" },
  "monday":     { title: "Closed Monday, workers everywhere", text: "No visitors on Mondays. Cleaners and repair workers were all over the building.", type: "evidence" },
  "plumber":    { title: "The plumber's story", text: "A plumber says a man in a white smock was stuck at a locked door near the back stairwell on Monday morning. The plumber opened it for him.", type: "evidence" },
  "photos":     { title: "“It's with the photographers”", text: "The guards guessed the painting was taken down to be photographed.", type: "assumption" },
  "nophotos":   { title: "Photographers never had it", text: "The guards' guess was wrong. The painting was gone for over a day before anyone checked.", type: "evidence" },
  "workers":    { title: "The staff list", text: "Five recent Salon Carré workers: Dufresne (cleaner), Bertin (frame repair), Aubry (wall painter), Garnier (electrician), Peruggia (glass fitter). Four have someone who can say where they were on Monday. One doesn't.", type: "evidence" },
  "collector":  { title: "“A millionaire hired a mastermind”", text: "A favorite newspaper theory.", type: "assumption" },
  "country":    { title: "“Another country did it”", text: "Another newspaper theory: a rival nation wanted to embarrass France.", type: "assumption" },
  "apollinaire":{ title: "Apollinaire knew a past Louvre thief", text: "True, but nothing connects him to this theft.", type: "evidence" },
  "apalibi":    { title: "Apollinaire's Monday", text: "He says he was at home writing. He gets angry when you ask, but he doesn't change his story.", type: "evidence" },
  "pglass":     { title: "Peruggia built glass boxes", text: "Peruggia says he worked at the Louvre, fitting the glass boxes over paintings.", type: "evidence" },
  "pmonday":    { title: "Peruggia's Monday", text: "He says he overslept on Monday and got to his new job late. Nobody saw him that morning.", type: "evidence" },
  "pitaly":     { title: "“She belongs to Italy”", text: "Peruggia gets excited about the Mona Lisa. He says Leonardo was Italian, so she belongs in Italy.", type: "evidence" },
  "pprints":    { title: "Peruggia's fingerprints", text: "He let you take a set of his prints.", type: "evidence" },
  "printmix":   { title: "The fingerprint mix-up", text: "Peruggia's old police file only has prints from his RIGHT hand. The print on the glass is a LEFT thumb. The clerk can't match them.", type: "evidence" },
  "harmless":   { title: "“Peruggia seems harmless”", text: "You crossed him off because he was calm and polite.", type: "assumption" },
  "trunk":      { title: "The painting in the trunk", text: "Under a false bottom in Peruggia's trunk, wrapped in red cloth: the Mona Lisa.", type: "evidence" },

  "d_smock":    { title: "Hidden under a smock", text: "A small wooden board fits under a white work smock. The thief could walk out looking like staff.", type: "deduction" },
  "d_insider":  { title: "Someone who knew the building", text: "The thief used a quiet stairwell and knew the museum closed Mondays. Look at people who worked there.", type: "deduction" },
  "d_glass":    { title: "He knew how the box came apart", text: "The glass box was taken off neatly, and Peruggia built those boxes.", type: "deduction" },
  "d_alibi":    { title: "No one can vouch for him", text: "A man in a white smock was at the back stairwell Monday morning, and Peruggia can't prove where he was.", type: "deduction" },
  "d_stories":  { title: "Two stories, zero facts", text: "The newspapers' favorite theories don't rest on a single clue.", type: "deduction" }
}>>
<<set setup.recipes = [
  { a: "panel",  b: "smock",     id: "d_smock" },
  { a: "frame",  b: "monday",    id: "d_insider" },
  { a: "frame",  b: "workers",   id: "d_insider" },
  { a: "frame",  b: "pglass",    id: "d_glass" },
  { a: "plumber",b: "pmonday",   id: "d_alibi" },
  { a: "genius", b: "collector", id: "d_stories" },
  { a: "genius", b: "country",   id: "d_stories" },
  { a: "collector", b: "country",id: "d_stories" }
]>>
<<set setup.interviews = {
  "guards": [
    { q: "Who was in the building on Monday?", a: "“Cleaners, repairmen, painters. Even some men who used to work here.”", clue: "monday" },
    { q: "Did anyone see something odd?", a: "“Ask the plumber. He says he let a man in a white smock through a locked door by the back stairs. Thought nothing of it.”", clue: "plumber" },
    { q: "Why didn't anyone notice it was gone?", a: "“We figured it was with the photographers. Paintings get taken down all the time.”", clue: "photos" },
    { q: "Who do you think did it?", a: "“A genius, obviously. Nobody ordinary could pull that off.”", clue: "genius" }
  ],
  "cafe": [
    { q: "Where were you on Monday?", a: "“At home, writing poems. Not at the Louvre!”", clue: "apalibi" },
    { q: "Did your friend steal from the Louvre?", a: "“Years ago, some little statues. Not paintings. I've told him to give them back.”", clue: "" },
    { q: "Do you hate old art?", a: "“I write about new art. That isn't a crime, Inspector.”", clue: "" },
    { q: "Do you know who took the Mona Lisa?", a: "“If I knew, I'd tell all of Paris. It would make a wonderful poem.”", clue: "" }
  ],
  "room": [
    { q: "What did you do at the Louvre?", a: "“Glass. I fitted the glass boxes over the paintings. Careful work.”", clue: "pglass" },
    { q: "Where were you Monday morning?", a: "“I overslept. I was late to my new job.” He shrugs.", clue: "pmonday" },
    { q: "What do you think of the Mona Lisa?", a: "His eyes light up. “Leonardo was Italian. She belongs in Italy.”", clue: "pitaly" },
    { q: "May I take your fingerprints?", a: "He holds out his hands without a fuss. “Of course.”", clue: "pprints" }
  ]
}>>
<<set setup.events = [
  { at: 6, id: "e1", kind: "headline", text: "CROWDS LINE UP AT THE LOUVRE TO STARE AT AN EMPTY WALL" },
