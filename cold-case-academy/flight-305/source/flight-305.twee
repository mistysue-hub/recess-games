  { id: "x2", need: "escaped", text: "He lands and drives off in a car waiting below.", fake: true }
]>>
<<set setup.interviews = {
  "schaffner": [
    { q: "What did the note say?", a: "“I thought it was a phone number, so I put it in my purse. He leaned over and said, ‘Miss, you'd better look at that note. I have a bomb.’”", clue: "note" },
    { q: "What was in the briefcase?", a: "“He opened it just a crack. Wires, red sticks, a big battery. I didn't want to look twice.”", clue: "bomb" },
    { q: "What did he want?", a: "“He had me write it down: $200,000 in twenties, four parachutes, and fuel trucks in Seattle.”", clue: "demands" },
    { q: "What did he look like?", a: "“Mid-forties. Five ten, maybe six feet. Dark hair, brown eyes. Very ordinary.”", clue: "descS" }
  ],
  "mucklow": [
    { q: "What happened in Seattle?", a: "“We landed, the passengers walked off, and the money and parachutes came aboard. He stayed in the back with me.”", clue: "swap" },
    { q: "What did he look like?", a: "“Mid-forties, five ten to six feet, dark hair, brown eyes. Polite the whole time.”", clue: "descM" },
    { q: "When did you last see him?", a: "“Around eight. He seemed to be tying something around his waist. He told me to go to the cockpit and stay there.”", clue: "waist" },
    { q: "Did he say anything odd?", a: "“He looked out the window and said, ‘Looks like Tacoma down there.’ And he knew McChord Air Force Base was only twenty minutes away.”", clue: "local" }
  ],
  "cockpit": [
    { q: "What orders did he give you?", a: "“Ten thousand feet, slow as we could go, gear down, flaps at fifteen, no cabin pressure, and the back stairs ready. We said that's not easy in a 727.”", clue: "orders" },
    { q: "When did the stairs open?", a: "“Around eight o'clock a warning light came on. The back stairs were down.”", clue: "light" },
    { q: "Did you feel anything?", a: "“At about 8:13 the tail jumped up, then settled. We all looked at each other.”", clue: "bump" },
    { q: "Where were you then?", a: "“Flying south on Victor 23 over southwest Washington. The FBI's computer put it up near Ariel and Lake Merwin. My own guess is farther south, closer to Portland.”", clue: "estimates" }
  ],
  "mitchell": [
    { q: "What did he look like?", a: "“I was sitting across the aisle. I'd say five nine, slim. Not as big as some people say.”", clue: "descB" },
    { q: "Did you notice anything wrong?", a: "“Not really. They said there was a mechanical problem and we'd circle for a while. I was mostly bored.”", clue: "circle" },
    { q: "What was he wearing?", a: "“A dark suit and a skinny black tie. A raincoat. Nothing special.”", clue: "plain" }
  ]
}>>
