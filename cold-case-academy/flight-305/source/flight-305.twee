<<set setup.moduleRef to "M02">>
<<set setup.leadsTotal to 7>>
<<set setup.dedTotal to 6>>
<<set setup.typeLabel to { evidence: "Fact", single: "One witness", assumption: "Guess", deduction: "Deduction" }>>
<<set setup.cards = {
  "ticket":   { title: "A cash ticket as “Dan Cooper”", text: "In Portland, a quiet man paid cash for a one-way ticket to Seattle, a 30-minute flight, under the name Dan Cooper.", type: "evidence" },
  "plain":    { title: "Nobody remembers his face well", text: "Dark suit, white shirt, black clip-on tie, a raincoat and a briefcase. He looked like any businessman.", type: "evidence" },
  "note":     { title: "The note", text: "Soon after takeoff he handed Florence Schaffner a note. She thought it was his phone number and put it in her purse unread. It said he had a bomb.", type: "evidence" },
  "bomb":     { title: "Wires and red sticks", text: "Schaffner saw inside his briefcase: wires, red sticks and a battery. Only she got a close look.", type: "single" },
  "demands":  { title: "His demands", text: "$200,000 in $20 bills, four parachutes (two main, two reserve), and fuel trucks waiting in Seattle.", type: "evidence" },
  "descS":    { title: "Schaffner's description", text: "Mid-forties, about 5 feet 10 to 6 feet tall, dark hair, brown eyes.", type: "single" },
  "descM":    { title: "Mucklow's description", text: "Mid-forties, about 5 feet 10 to 6 feet tall, dark hair, brown eyes. Calm and polite.", type: "single" },
  "descB":    { title: "Mitchell's description", text: "Shorter and slighter, about 5 feet 9. That's how passenger Bill Mitchell remembers him.", type: "single" },
  "circle":   { title: "Circling Seattle", text: "The plane circled Seattle for more than two hours while the FBI gathered the cash. Most passengers were told it was a mechanical problem.", type: "evidence" },
  "serials":  { title: "10,000 photographed bills", text: "Before handing over the money, the FBI photographed all 10,000 $20 bills on microfilm, so every serial number is on file.", type: "evidence" },
  "swap":     { title: "The swap in Seattle", text: "The plane landed around 5:40 p.m. The 35 other passengers walked off in exchange for the money and parachutes. The crew stayed.", type: "evidence" },
  "polite":   { title: "Calm and polite", text: "He asked for meals to be brought for the flight crew. He never raised his voice.", type: "single" },
  "local":    { title: "He knew the area", text: "Looking out the window, he said, “Looks like Tacoma down there,” and knew McChord Air Force Base was only about 20 minutes from the airport.", type: "single" },
  "waist":    { title: "Something tied at his waist", text: "Around 8:00 p.m., the last time Tina Mucklow saw him, he seemed to be tying something around his waist. Then he sent her to the cockpit.", type: "single" },
  "orders":   { title: "His flight orders", text: "Fly south toward Mexico at about 10,000 feet, as slowly as possible (about 100 knots), landing gear down, flaps at 15 degrees, cabin not pressurized, back stairs ready to open.", type: "evidence" },
  "takeoff":  { title: "Off again, heading south", text: "The plane took off again around 7:40 p.m., heading toward Reno for fuel on the way to Mexico.", type: "evidence" },
  "light":    { title: "The stairs light", text: "Around 8:00 p.m., a cockpit warning light showed the back stairs had been lowered.", type: "evidence" },
  "bump":     { title: "The bump at 8:13", text: "At about 8:13 p.m., the tail of the plane suddenly jumped upward, as if a weight had left the stairs.", type: "evidence" },
  "route":    { title: "Where they were", text: "The plane was flying south on an airway called Victor 23, over the forests of southwest Washington, between Seattle and Portland.", type: "evidence" },
  "estimates":{ title: "Two jump-spot estimates", text: "The FBI's first computer estimate put the jump near Ariel and Lake Merwin, north of the Lewis River. The co-pilot later thought it was farther south, near Portland's northern suburbs.", type: "evidence" },
  "gone":     { title: "Gone in Reno", text: "When the plane landed in Reno late that night, the back stairs were down and the man was gone. So was the money.", type: "evidence" },
  "tie":      { title: "The clip-on tie", text: "On his seat: a thin black clip-on tie with a mother-of-pearl tie clip. Bag it. Someday, science may find something on it.", type: "evidence" },
  "butts":    { title: "Eight cigarette butts", text: "Eight cigarette butts in the ashtray by his seat in the last row.", type: "evidence" },
  "prints":   { title: "66 fingerprints", text: "Agents lifted 66 fingerprints from the plane. Hundreds of people use a plane, so nobody knows which, if any, are his.", type: "evidence" },
  "chutes":   { title: "The parachutes", text: "He took one main and one reserve. He left one main, and a reserve with some of its cords cut out. One reserve he was given was a classroom dummy, sewn shut, and it was never found on the plane.", type: "evidence" },
  "escort":   { title: "The chase planes saw nothing", text: "Two fighter jets and a training plane followed the airliner, but in the dark clouds they never saw anyone jump.", type: "evidence" },
  "weather":  { title: "A terrible night", text: "It was dark and stormy, with sleet. At 10,000 feet it was well below freezing.", type: "evidence" },
  "name":     { title: "Why “D.B.”?", text: "He called himself Dan Cooper. A reporter rushing to meet a deadline mixed him up with another name and wrote “D.B. Cooper.” It stuck.", type: "evidence" },
  "pro":      { title: "“He must be a paratrooper”", text: "A newspaper says only a trained army paratrooper would dare jump like that.", type: "assumption" },
  "escaped":  { title: "“He landed and drove away”", text: "Another paper says he surely had a car waiting below.", type: "assumption" },
  "seattlejump":{ title: "“He jumped over Seattle”", text: "A caller to the newsroom swears the hijacker jumped out over Seattle before the plane ever landed.", type: "assumption" },

  "d_agree":  { title: "Two witnesses agree", text: "Both flight attendants, who spent the most time near him, describe the same man. That's stronger than one witness alone.", type: "deduction" },
  "d_unsure": { title: "The description isn't certain", text: "Witnesses don't all agree on his height or build. Any sketch is a best guess.", type: "deduction" },
  "d_planned":{ title: "He planned ahead", text: "Four parachutes, exact amounts, fuel trucks, and orders that kept the plane low and slow: this wasn't a spur-of-the-moment crime.", type: "deduction" },
  "d_planes": { title: "He knew about planes", text: "He knew the back stairs of this jet could open in flight, and he knew the local air base. He may have had aviation or military experience.", type: "deduction" },
  "d_window": { title: "A jump window", text: "The bump at 8:13, the slow speed and the route together tell searchers roughly where to look.", type: "deduction" },
  "d_bag":    { title: "He tied the money to himself", text: "Cords cut from a parachute, and something tied around his waist: he probably made a money bag he could jump with.", type: "deduction" }
}>>
