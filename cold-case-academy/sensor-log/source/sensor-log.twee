]>>
<<set setup.interviews = {
  "guard": [
    { q: "Why did you let them in?", a: "“They were police. They said there was a disturbance. The rule was nobody comes in at night, but… they were police.”", clue: "buzzer" },
    { q: "What happened at the desk?", a: "“One of them said I looked familiar, like there might be a warrant for me. He told me to come out from behind the desk. That's where the alarm button was.”", clue: "alarm" },
    { q: "Why did you open the side door earlier?", a: "“I always checked it. I opened it and shut it, to make sure it locked. That's all.”", clue: "sidedoor" },
    { q: "Were you in the Blue Room tonight?", a: "“Sure, on my rounds, earlier. I walked through every room on the first floor.”", clue: "blueEarlier" }
  ],
  "partner": [
    { q: "What happened to you?", a: "“The other guard called me over. Next thing I knew, I was in handcuffs, and they took us both down to the basement.”", clue: "basement" },
    { q: "Did you see where they went?", a: "“No. We were in the basement the whole time.”", clue: null },
    { q: "Was anyone outside before?", a: "“I didn't see anything. Ask the people on the street. It was St. Patrick's Day, lots of folks walking home.”", clue: null }
  ]
}>>
<<set setup.events = [
  { at: 6, id: "e1", kind: "headline", text: "THIEVES DRESSED AS POLICE ROB GARDNER MUSEUM" },
  { at: 4, id: "e2", kind: "chief", text: "Your lieutenant calls: “The FBI's on the way. I need the timeline, the rooms, and anything that smells wrong.”" },
  { at: 2, id: "e3", kind: "headline", text: "MASTERPIECES WORTH MILLIONS VANISH IN THE NIGHT" }
]>>
