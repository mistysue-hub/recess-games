:: StoryInit
<<set setup.mapPins to [{"dest": "Third", "label": "Third floor", "icon": "🪜", "x": 36, "y": 13}, {"dest": "Newsroom", "label": "Newspaper", "icon": "📰", "x": 86, "y": 12}, {"dest": "Dutch", "label": "Dutch Room", "icon": "🖼️", "x": 13, "y": 37}, {"dest": "Short", "label": "Short Gallery", "icon": "🦅", "x": 60, "y": 37}, {"dest": "Blue", "label": "Blue Room", "icon": "🎩", "x": 13, "y": 59}, {"dest": "Security", "label": "Security office", "icon": "🖨️", "x": 60, "y": 59}, {"dest": "Street", "label": "The street", "icon": "🚓", "x": 86, "y": 58}, {"dest": "Guard", "label": "Door guard", "icon": "🗣️", "x": 20, "y": 81}, {"dest": "Partner", "label": "Second guard", "icon": "🗣️", "x": 56, "y": 81}]>>
<<set setup.moduleRef to "M06">>
<<set setup.leadsTotal to 7>>
<<set setup.dedTotal to 5>>
<<set setup.typeLabel to { evidence: "Fact", single: "One witness", assumption: "Guess", deduction: "Deduction" }>>
<<set setup.cards = {
  "buzzer":   { title: "1:24 a.m.: the buzzer", text: "Two men in police uniforms buzzed the side door and said they were answering a disturbance call. The guard let them in.", type: "single" },
  "alarm":    { title: "Away from the alarm", text: "The men told the guard he looked familiar, as if there might be a warrant for him, and got him to step away from the desk, where the only alarm button was.", type: "single" },
  "basement": { title: "Both guards in the basement", text: "Both guards were handcuffed and left in the basement until morning. Neither was badly hurt.", type: "evidence" },
  "tapes":    { title: "The camera tapes are gone", text: "The thieves took the tapes from the security cameras.", type: "evidence" },
  "sensors":  { title: "The motion-detector record", text: "About 60 motion detectors recorded every movement in the galleries, with the time. The thieves took the paper printouts, but the same record was saved on a computer they never touched.", type: "evidence" },
  "first":    { title: "1:48 a.m.: first movement", text: "The detectors first recorded the thieves moving in the galleries at about 1:48 a.m.", type: "evidence" },
  "dutch":    { title: "Movement in the Dutch Room", text: "The detectors recorded movement in the Dutch Room, upstairs.", type: "evidence" },
  "short":    { title: "Movement in the Short Gallery", text: "The detectors recorded movement in the Short Gallery, a long narrow hall upstairs.", type: "evidence" },
  "blueSilent":{ title: "No movement in the Blue Room", text: "While the thieves were inside, the detectors recorded no movement at all in the Blue Room, downstairs.", type: "evidence" },
  "blueEarlier":{ title: "Earlier footsteps in the Blue Room", text: "The only movement recorded in the Blue Room that night was earlier, during the guard's rounds.", type: "evidence" },
  "leave":    { title: "2:45 a.m.: gone", text: "The thieves made two trips out to their car and left for good at 2:45 a.m.", type: "evidence" },
  "dutchLoss":{ title: "Missing from the Dutch Room", text: "Vermeer's The Concert, three Rembrandts (two paintings and a tiny etching), a Flinck landscape, and a 3,000-year-old Chinese bronze cup.", type: "evidence" },
  "cut":      { title: "Cut from the frames", text: "Two Rembrandt paintings were cut out of their frames with a blade. Others, like the Vermeer, were pulled out of theirs. Glass lies smashed on the marble floor.", type: "evidence" },
  "panel":    { title: "The Rembrandt they left", text: "A large Rembrandt self-portrait was taken down, then left leaning against a cabinet. It's painted on a heavy wooden panel, not canvas.", type: "evidence" },
  "shortLoss":{ title: "Missing from the Short Gallery", text: "Five small Degas drawings, and a bronze eagle from the top of a Napoleonic flagpole.", type: "evidence" },
  "blueLoss": { title: "Missing from the Blue Room", text: "Manet's Chez Tortoni, a small painting of a man in a top hat at a café table.", type: "evidence" },
  "titian":   { title: "The third floor, untouched", text: "Upstairs on the third floor, a famous Titian painting, one of the most valuable in the museum, is still on the wall. The detectors show nobody went up there.", type: "evidence" },
  "sidedoor": { title: "The side door, earlier", text: "Earlier that night, the guard opened the side door for a moment and closed it again. He says it was part of checking that it was locked.", type: "single" },
  "car":      { title: "Two men in a car", text: "People walking home from parties saw two men in police uniforms sitting in a hatchback near the museum before the theft.", type: "single" },
  "inside":   { title: "“It was an inside job”", text: "A reporter is sure one of the guards was in on it.", type: "assumption" },
  "genius":   { title: "“Expert art thieves”", text: "Another reporter says only expert art thieves would pick such famous paintings.", type: "assumption" },

  "d_81":     { title: "81 minutes", text: "From the buzzer at 1:24 a.m. to leaving at 2:45 a.m.: 81 minutes inside the museum.", type: "deduction" },
  "d_record": { title: "A witness they missed", text: "The thieves took the camera tapes and the printouts, but missed the copy saved on the computer. It became the best witness of the night.", type: "deduction" },
  "d_odd":    { title: "The fact that doesn't fit", text: "A painting is missing from the Blue Room, but the detectors recorded nobody there while the thieves were inside.", type: "deduction" },
  "d_notexperts":{ title: "Not picky experts", text: "They cut paintings from their frames, took a cheap bronze eagle, and never went near the Titian. That's not how expert art thieves usually work.", type: "deduction" },
  "d_trick":  { title: "A trick, not a break-in", text: "Police uniforms, a fake story about a warrant, and getting the guard away from the alarm: they talked their way in.", type: "deduction" }
}>>
<<set setup.recipes = [
  { a: "buzzer", b: "leave", id: "d_81" },
  { a: "tapes", b: "sensors", id: "d_record" },
  { a: "blueSilent", b: "blueLoss", id: "d_odd" },
  { a: "cut", b: "titian", id: "d_notexperts" },
  { a: "shortLoss", b: "titian", id: "d_notexperts" },
  { a: "buzzer", b: "alarm", id: "d_trick" }
]>>
<<set setup.rooms = [
  { id: "dutch", name: "Dutch Room (upstairs)", answer: "yes", need: "dutch" },
  { id: "short", name: "Short Gallery (upstairs)", answer: "yes", need: "short" },
  { id: "blue", name: "Blue Room (downstairs)", answer: "no", need: "blueSilent" },
