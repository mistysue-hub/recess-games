<<set setup.leadsTotal to 7>>
<<set setup.dedTotal to 5>>
<<set setup.kindLabel to { time: "Written at the time", later: "Written later", modern: "Modern", fact: "Physical evidence", assumption: "Guess", deduction: "Deduction" }>>
<<set setup.leanLabel to { richard: "Points to: Richard III", buck: "Points to: Buckingham", henry: "Points to: Henry VII", survived: "Points to: they survived", neither: "Doesn't decide" }>>
<<set setup.cards = {
  "palace":   { title: "A palace, too", text: "In 1483 the Tower of London was a royal home as well as a fortress. New kings often stayed there before being crowned.", type: "fact", lean: "neither" },
  "control":  { title: "In their uncle's care", text: "Both boys were in the Tower under the control of their uncle Richard, who was in charge of the kingdom.", type: "fact", lean: "richard" },
  "titulus":  { title: "The Titulus Regius, 1484", text: "Parliament's law said the boys' parents were never properly married, so the boys couldn't be kings. It says nothing about where the boys were.", type: "time", lean: "neither" },
  "mancini":  { title: "Mancini's report, 1483", text: "An Italian visitor wrote that summer that the boys were seen less and less, then not at all. People feared they were dead. He admitted he didn't know.", type: "time", lean: "neither" },
  "neverShown":{ title: "Never shown in public", text: "As rumors spread, King Richard III never brought the boys out to prove they were alive.", type: "fact", lean: "richard" },
  "more":     { title: "Thomas More's history, about 1513", text: "Written about 30 years later, while the new Tudor kings ruled: Richard III ordered the boys killed. More was a small child in 1483 and named no sources.", type: "later", lean: "richard" },
  "play":     { title: "Shakespeare's play, 1590s", text: "Shakespeare's Richard III follows More's story and makes Richard a villain. It's a play, written more than 100 years later.", type: "later", lean: "richard" },
  "buckDoc":  { title: "Documents naming Buckingham", text: "A few old documents, some written years later, blame the Duke of Buckingham, Richard's powerful ally.", type: "later", lean: "buck" },
  "buckAccess":{ title: "Could Buckingham get in?", text: "Historians point out Buckingham would have had a hard time reaching the boys without Richard knowing.", type: "fact", lean: "neither" },
  "henry":    { title: "Henry VII's motive", text: "Henry Tudor became king in 1485. If the boys were still alive then, they'd have been a threat to him too. Nobody accused him at the time.", type: "fact", lean: "henry" },
  "warbeck":  { title: "Perkin Warbeck's claim", text: "From 1491, a young man said he was the younger prince, escaped. Some foreign rulers backed him.", type: "time", lean: "survived" },
  "confession":{ title: "Warbeck's confession, 1497", text: "After he was captured, Warbeck confessed that he wasn't the prince. Most historians believe the confession.", type: "time", lean: "neither" },
  "bones":    { title: "The box under the stairs, 1674", text: "Workmen found two children's skeletons in a wooden box, ten feet under an old staircase at the Tower.", type: "fact", lean: "neither" },
  "urn":      { title: "The urn in Westminster Abbey", text: "King Charles II had the bones placed in an urn in Westminster Abbey in 1678, as the princes.", type: "fact", lean: "neither" },
  "exam":     { title: "The 1933 examination", text: "Scientists said the bones were two children of about the right ages, but couldn't tell if they were boys or girls, or how old the bones were.", type: "modern", lean: "neither" },
  "nodna":    { title: "No DNA test", text: "Nobody has been given permission to test the bones with modern science like DNA.", type: "modern", lean: "neither" },
  "langley":  { title: "Langley's documents, 2023–2025", text: "Researcher Philippa Langley published old documents, in 2023 and again in 2025, that she says show both boys survived and escaped to Europe.", type: "modern", lean: "survived" },
  "critics":  { title: "Historians on Langley", text: "Many historians say the documents are interesting but don't prove the boys survived.", type: "modern", lean: "neither" },
  "ghosts":   { title: "“Their ghosts walk the Tower”", text: "A tour guide's spooky story. Fun, but it isn't evidence of anything.", type: "assumption", lean: "neither" },
  "swap":     { title: "“They were swapped at birth”", text: "A website claims the real princes were secretly swapped with other boys.", type: "assumption", lean: "neither" },

  "d_control":{ title: "Means and motive", text: "The boys were under Richard's control, stood between him and the crown, and he never showed them alive. That's why most historians suspect him.", type: "deduction", lean: "richard" },
  "d_bias":   { title: "Written under the winners", text: "More wrote 30 years later, while the kings who replaced Richard ruled, and named no sources. Useful, but handle with care.", type: "deduction", lean: "neither" },
  "d_unknownBones":{ title: "Bones that can't decide", text: "Two children's skeletons, never sexed, never dated, never DNA-tested: they fit the story, but they can't prove it.", type: "deduction", lean: "neither" },
  "d_pretender":{ title: "A claim, then a confession", text: "Warbeck said he was the prince, then confessed he wasn't. A claim taken back isn't strong evidence.", type: "deduction", lean: "neither" },
  "d_notproof":{ title: "Interesting isn't proof", text: "New documents can open a question again without settling it.", type: "deduction", lean: "neither" }
}>>
<<set setup.recipes = [
  { a: "control", b: "neverShown", id: "d_control" },
  { a: "more", b: "mancini", id: "d_bias" },
  { a: "more", b: "play", id: "d_bias" },
  { a: "bones", b: "exam", id: "d_unknownBones" },
  { a: "exam", b: "nodna", id: "d_unknownBones" },
  { a: "warbeck", b: "confession", id: "d_pretender" },
  { a: "langley", b: "critics", id: "d_notproof" }
]>>
