:: PlaceArt [script]
setup.placeArt = {"Cells": {"color": "#5d6670"}, "Corridor": {"color": "#3a4048", "svg": "<svg class=\"art placepic\" viewBox=\"0 0 640 190\" role=\"img\" aria-label=\"A dark, narrow utility corridor behind the cells, full of pipes, lit by a guard&#x27;s flashlight.\" preserveAspectRatio=\"xMidYMid slice\"><rect x=\"0\" y=\"0\" width=\"640\" height=\"190\" rx=\"0\" fill=\"#262a2f\" /><rect x=\"0\" y=\"24\" width=\"640\" height=\"8\" rx=\"0\" fill=\"#4a4f54\" /><rect x=\"0\" y=\"50\" width=\"640\" height=\"8\" rx=\"0\" fill=\"#4a4f54\" /><rect x=\"0\" y=\"120\" width=\"640\" height=\"8\" rx=\"0\" fill=\"#4a4f54\" /><rect x=\"120\" y=\"0\" width=\"10\" height=\"190\" rx=\"0\" fill=\"#3a3f44\" /><rect x=\"360\" y=\"0\" width=\"10\" height=\"190\" rx=\"0\" fill=\"#3a3f44\" /><rect x=\"560\" y=\"0\" width=\"10\" height=\"190\" rx=\"0\" fill=\"#3a3f44\" /><path d=\"M0 100 L640 40 L640 40 Z\" fill=\"#fff6c0\" opacity=\".22\"/><path d=\"M0 100 L640 170 L640 170 Z\" fill=\"#fff6c0\" opacity=\".0\"/><g transform=\"translate(60 76) scale(1 1)\"><rect x=\"-12\" y=\"40\" width=\"10\" height=\"34\" rx=\"3\" fill=\"#3a3a46\" /><rect x=\"2\" y=\"40\" width=\"10\" height=\"34\" rx=\"3\" fill=\"#3a3a46\" /><path d=\"M-18 44 L-16 10 Q0 2 16 10 L18 44 Z\" fill=\"#5a6a7a\" /><rect x=\"-24\" y=\"12\" width=\"7\" height=\"28\" rx=\"3\" fill=\"#5a6a7a\" /><rect x=\"17\" y=\"12\" width=\"7\" height=\"28\" rx=\"3\" fill=\"#5a6a7a\" /><circle cx=\"-20\" cy=\"41\" r=\"4\" fill=\"#d9a77c\" /><circle cx=\"20\" cy=\"41\" r=\"4\" fill=\"#d9a77c\" /><circle cx=\"0\" cy=\"-6\" r=\"12\" fill=\"#d9a77c\" /><path d=\"M-12 -8 Q0 -24 12 -8 Q8 -14 0 -14 Q-8 -14 -12 -8 Z\" fill=\"#3a2a1a\" /><path d=\"M-14 -12 L14 -12 L12 -22 L-12 -22 Z\" fill=\"#1f2a44\" /><rect x=\"-16\" y=\"-13\" width=\"32\" height=\"4\" rx=\"2\" fill=\"#111\" /><circle cx=\"0\" cy=\"-17\" r=\"2.5\" fill=\"#d4af37\" /></g><g transform=\"translate(260 80) scale(1 1)\"><rect x=\"0\" y=\"0\" width=\"36\" height=\"26\" rx=\"2\" fill=\"#7a7