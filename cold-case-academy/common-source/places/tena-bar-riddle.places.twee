:: PlaceArt [script]
setup.placeArt = {"Lab": {"color": "#2f5d8a", "svg": "<svg class=\"art placepic\" viewBox=\"0 0 640 190\" role=\"img\" aria-label=\"A lab bench where soggy old bills are laid out next to a printed list of serial numbers and a microscope.\" preserveAspectRatio=\"xMidYMid slice\"><rect x=\"0\" y=\"0\" width=\"640\" height=\"150\" rx=\"0\" fill=\"#dfe6e8\" /><rect x=\"0\" y=\"150\" width=\"640\" height=\"40\" rx=\"0\" fill=\"#7a8a8e\" /><rect x=\"0\" y=\"146\" width=\"640\" height=\"6\" rx=\"0\" fill=\"#5a6a6e\" /><line x1=\"40\" y1=\"152\" x2=\"10\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><line x1=\"110\" y1=\"152\" x2=\"80\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><line x1=\"180\" y1=\"152\" x2=\"150\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><line x1=\"250\" y1=\"152\" x2=\"220\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><line x1=\"320\" y1=\"152\" x2=\"290\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><line x1=\"390\" y1=\"152\" x2=\"360\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><line x1=\"460\" y1=\"152\" x2=\"430\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><line x1=\"530\" y1=\"152\" x2=\"500\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><line x1=\"600\" y1=\"152\" x2=\"570\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><line x1=\"670\" y1=\"152\" x2=\"640\" y2=\"190\" stroke=\"#5a6a6e\" stroke-width=\"1.5\" opacity=\".35\"/><g transform=\"translate(60 100) scale(1.2 1.2)\"><rect x=\"0\" y=\"0\" width=\"300\" height=\"10\" rx=\"2\" fill=\"#c9d3d6\" /><rect x=\"6\" y=\"10\" width=\"10\" height=\"40\" rx=\"0\" fill=\"#7a8a8e\" /><rect x=\"284\" y=\"10\" width=\"10\" height=\"40\" rx=\"0\" fill=\"#7a8a8e\" /><rect x=\"230\" y=\"10\" width=\"54\" height=\"24\" rx=\"2\" fill=\"#7a8a8e\" /><rect x=\"250\" y=\"20\" width=\"14\" height=\"3\"