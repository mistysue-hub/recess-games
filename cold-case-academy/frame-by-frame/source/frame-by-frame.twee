<<set setup.dedTotal to 5>>
<<set setup.typeLabel to { evidence: "Fact", claim: "Claim", single: "One witness", opinion: "Expert opinion", assumption: "Guess", deduction: "Deduction" }>>
<<set setup.cards = {
  "frames":   { title: "The empty frames", text: "Isabella Stewart Gardner's will says nothing can be moved, sold or replaced, so the empty frames hang right where the paintings used to be.", type: "evidence" },
  "reward":   { title: "The $10 million reward", text: "$1 million in 1990, $5 million in 1997, $10 million since 2017, for information that leads directly to getting the art back in good condition.", type: "evidence" },
  "eagle":    { title: "$100,000 for the eagle", text: "A separate reward is offered just for the bronze eagle from the Napoleonic flag.", type: "evidence" },
  "letter":   { title: "The 1994 letter", text: "An anonymous writer said the art was safe in another country and asked for $2.6 million and a promise of no arrests. The museum answered in a coded newspaper message. The writer went silent.", type: "claim" },
  "warehouse":{ title: "The 1997 warehouse", text: "A man showed a reporter, by flashlight, a rolled-up canvas that looked like Rembrandt's Storm in a Brooklyn warehouse.", type: "claim" },
  "chips":    { title: "The paint chips", text: "Experts said the paint chips he handed over were from Rembrandt's time, but they didn't match the Storm.", type: "evidence" },
  "raid":     { title: "The warehouse search", text: "When the FBI searched the warehouse later, nothing was there.", type: "evidence" },
  "fbi2013":  { title: "The FBI's 2013 statement", text: "The FBI said it believed, “with a high degree of confidence,” it knew who the thieves were: members of a criminal group based in the mid-Atlantic states and New England.", type: "evidence" },
  "fbi2015":  { title: "Both thieves are dead", text: "In 2015, the FBI said both thieves had died. It never named them in public.", type: "evidence" },
  "philly":   { title: "Connecticut and Philadelphia", text: "The FBI said the art was taken to Connecticut and Philadelphia after the theft, and that someone tried to sell some of it around 2002.", type: "evidence" },
  "shed":     { title: "The empty hiding place", text: "Agents searched an older Connecticut man's house and yard. Under a shed they found a hiding place. It was empty.", type: "evidence" },
  "sketch":   { title: "The police sketches", text: "People walking by before the theft saw two men in police uniforms in a car. Police drew sketches from their descriptions.", type: "single" },
  "relatives":{ title: "A painting on a bedroom wall", text: "Relatives of one man who resembled a sketch later said they remembered a painting like the Manet in his room. He died in 1991.", type: "claim" },
  "guardfacts":{ title: "The night guard", text: "He opened the side door before the thieves came, and the only Blue Room footsteps were his. He always denied any part in the theft, was never charged, and died in 2024.", type: "evidence" },
  "limit":    { title: "Too late to charge", text: "The time limit for charging the theft ran out in 1995.", type: "evidence" },
  "noCharge": { title: "Maybe safe to return it", text: "Prosecutors have said they would consider not charging someone who returns the art.", type: "evidence" },
  "survive":  { title: "Thieves rarely destroy art", text: "The museum's head of security says history shows thieves almost never destroy famous art. They hide it.", type: "opinion" },
  "fire":     { title: "“It all burned in a fire”", text: "A caller to a radio show is sure the paintings were burned years ago.", type: "assumption" },
  "vault":    { title: "“A billionaire's secret vault”", text: "A reporter says some rich collector ordered the theft and keeps the paintings in a hidden room.", type: "assumption" },

  "d_whowhere":{ title: "Who isn't where", text: "The FBI says it knows who the thieves were, and that they're dead. That still doesn't say where the art is.", type: "deduction" },
  "d_dead":   { title: "No one left to punish", text: "The thieves are dead and the time limit ran out in 1995. The only goal left is getting the art back.", type: "deduction" },
  "d_glimpse":{ title: "A glimpse isn't proof", text: "A canvas seen by flashlight, chips that don't match, and an empty warehouse: the 1997 lead proved nothing.", type: "deduction" },
  "d_trail":  { title: "A trail that went cold", text: "The art reportedly went to Connecticut and Philadelphia, and the Connecticut hiding place was empty when agents finally looked.", type: "deduction" },
  "d_waiting":{ title: "Why the frames wait", text: "The will keeps the frames on the wall, and experts think the art still exists. The frames are waiting for something real.", type: "deduction" }
}>>
<<set setup.recipes = [
  { a: "fbi2013", b: "fbi2015", id: "d_whowhere" },
  { a: "fbi2015", b: "limit", id: "d_dead" },
  { a: "warehouse", b: "chips", id: "d_glimpse" },
  { a: "warehouse", b: "raid", id: "d_glimpse" },
  { a: "philly", b: "shed", id: "d_trail" },
  { a: "frames", b: "survive", id: "d_waiting" }
]>>
<<set setup.theories = [
  { id: "tBack", text: "The art has already been returned", answer: "out", needs: ["frames","d_waiting"], why: "The frames on the wall are still empty." },
  { id: "tShed", text: "It's hidden under the shed in Connecticut", answer: "out", needs: ["shed","d_trail"], why: "Agents found that hiding place, and it was empty." },
  { id: "tWarehouse", text: "It's in the Brooklyn warehouse", answer: "out", needs: ["raid","d_glimpse"], why: "The FBI searched the warehouse and found nothing." },
  { id: "tHidden", text: "It's hidden somewhere, waiting to surface", answer: "possible", needs: [], why: "Nobody can prove or disprove it, and experts think it's likely." },
  { id: "tFire", text: "It was destroyed long ago", answer: "possible", needs: [], why: "Experts doubt it, but nobody can rule it out." }
]>>
<<set setup.suspects = [
  { id: "guard", name: "The night guard", facts: ["Let the fake police officers in.", "Opened the side door briefly earlier that night.", "The only footsteps recorded in the Blue Room that night were his, from his rounds.", "Always said he had nothing to do with it. Never charged. Died in 2024.", "In 2026, the former lead FBI agent wrote that he thinks the guard could have been charged."], keys: [["Reporters called it an inside job", false], ["The door and the Blue Room record", true], ["He was young and worked nights", false]], note: "The motion record and the door can actually be checked. A reporter's opinion and his age can't tell you anything about the theft. Even checkable evidence only made investigators suspicious; it never proved anything." },
  { id: "sketchman", name: "A man who resembled a sketch", facts: ["Looked like one of the police sketches of the thieves.", "Investigators looked hard at him and men he knew.", "After he died in 1991, relatives said they remembered a painting like the Manet in his room.", "Never charged."], keys: [["How closely he matched the sketch", true], ["His relatives' memory of a painting", false], ["He knew people in the criminal world", false]], note: "A sketch can be compared with photos. A memory from years later can't be checked anymore, and who someone knows isn't evidence of what they did." },
  { id: "ctman", name: "An older man in Connecticut", facts: ["The FBI believed for years that he knew where some of the art went.", "He always denied knowing anything about it.", "Agents searched his house and yard and found a hiding place under a shed. It was empty.", "Never charged with the theft. He died in 2021."], keys: [["The FBI believed he knew something", false], ["The search, and the empty hiding place", true], ["He was old", false]], note: "A belief isn't evidence. The search is: it was checked, and it found nothing." }
]>>
